# Dependencies
node_modules/
**/node_modules/

# Build outputs
frontend2/.output/
frontend2/.vinxi/
frontend2/dist/
*.js.map

# Environment / secrets
.env
.env.*
!.env.example

# API key credential files (never commit)
*.rtf
Nvidia_api_key.rtf
AWS_ACESS_DETAILS.rtf

# Screenshots
Screenshot*.png

# Logs
*.log
logs/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Model cache (large, regenerated at startup)
model-cache.json
memory-store.json

# Vault bootstrap state (self-hosted master key + sealed claimed keys — written
# at runtime by vault-boot.ts into ENZO_DATA_DIR, which defaults to <repo>/data)
data/

# Background health-ping store (live status + latency per model, regenerated every 5 min)
model-health.json

# Outbound throttle state + NVIDIA reachability verification cache
throttle-state.json
nvidia-verified.json
llm7-verified.json

# User-taught skills (learned from GitHub repos) — local, not committed.
# Anchored to the repo root: an unanchored `skills/` also ignores
# src/skills/*.ts in fresh clones (where those tracked files don't yet
# have index entries shielding them), which breaks `git add` and tsc.
/skills/
src/skills/.skill-tmp/
# The skill store itself resolves to src/skills/skills/ (SKILLS_DIR =
# __dirname/skills in skills.ts) — runtime per-install state, never committed.
src/skills/skills/

# Local agent-tooling workspaces (not part of the product)
.agents/

# Saved custom agents + run records (per-install state, not source) — same
# anchoring rule as /skills/ above: unanchored `agents/` would also ignore
# src/agents/*.ts in fresh clones and break git add + tsc.
src/agents/agents/
# ENZO Intelligence investigations — collected evidence + run history are
# per-install user data (volume-mounted in docker), never committed.
src/intelligence/data/
# Neural Engine per-owner profiles/graphs/events — same per-install policy.
src/neural-engine/data/

# Generated multi-file projects (written to disk by coding mode) — local
generated-projects/

# Python cache
__pycache__/
*.pyc

# Test artifacts
test/
# ci-runner.sh writes its step-by-step report here on every run
.ci-report.txt

# Large media / video assets (use Git LFS or external storage)
Homepage_Video/
Open_Animation/
cinematic/

# Local/unrelated temp directories
Truus.co-Awwward-Website/
Browserpad - A notepad in the browser.xhtml
download.pdf
readme.txt
.claude/
anime_elements/

# Duplicate video assets (82MB — byte-for-byte copy of synthetic-nature/public/background_elements/marketplace/)
marketplace_theme/

# Personal / stray files that do not belong in source control
*.pdf
AWS_ACESS_DETAILS.rtf
Nvidia_api_key.rtf

# OAuth credentials + refresh tokens (written at runtime, AES-256-GCM sealed on
# disk by crypto-store.ts — still never committed, sealed or not)
.gmail-tokens.json
client_secret_*.json

# Regenerated caches (rebuilt on demand; committing them just creates conflicts)
cloudflare-plan-tier.json
model-info-cache.json

# Editor / tooling scratch
.kilo/
.qodo/
*.vsix

# Local clones and scratch trees that live beside the source but are not ours
claude-code-main/
claude-code-leaked-main/
lamp/
X

# Promo source material (large originals; shipped copies live in synthetic-nature/public)
promotional _images/

# Coding-mode scratch projects created outside generated-projects/
enzo-project-*/

# The test suite is tracked on purpose: `npm test` in CI runs these files by
# path, so ignoring tests/ makes a fresh clone fail with ERR_MODULE_NOT_FOUND.
# (.env.example itself is tracked: it is a sanitized placeholder template with
# no real values — `cp .env.example .env` is step 1 of the README quick-start,
# which a fresh clone could otherwise not perform.)
config/.env.example

# tsc incremental cache — local build artifact, never ship
*.tsbuildinfo

# docker repo: dist is built inside the image, never committed
synthetic-nature/dist

# desktop build artifacts
desktop/dist/
desktop/windows/staged/

# Local media scratch — source copies and scraped artwork that the product
# does not read at runtime:
#   * Subway_…gwr_video_mvp.mp4 — the raw 15MB source clip at the repo root;
#     the shipped loops live in synthetic-nature/public/background_elements/.
#   * modelcover/ — a local scrape of provider cover art. The marketplace
#     fetches each platform's own art at runtime, so this copy is redundant.
#   * promo.png — an old promo export; the app icon is
#     desktop/assets/enzo-icon-1024.png and the website favicons are in
#     synthetic-nature/public/.
Subway_*_gwr_video_mvp.mp4
modelcover/
promo.png

# tsc emit of vite.config.ts (the tracked source is vite.config.ts)
synthetic-nature/vite.config.js
synthetic-nature/vite.config.d.ts
