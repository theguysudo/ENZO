# ─── ENZO AI Backend — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your actual values.
# ⚠️  NEVER commit .env to git. It is already in .gitignore.
#
# Two deployment modes:
#
# 1) SELF-HOSTED (single operator): fill in provider keys below — the server
#    holds them and the Vault UI can also write them into .env.
#
# 2) HOSTED / BYOK (many users, one URL): leave the provider keys EMPTY. The
#    server boots keyless; each visitor stores their OWN keys in the vault UI
#    and they are sent with every request (never persisted server-side).
#
# REQUIRED in BOTH modes: nothing — the server boots with zero provider keys.
# OPTIONAL keys enable server-side pooled/fallback features (self-hosted mode).

# ── Core API Keys (self-hosted mode only — leave empty in BYOK/hosted) ────────

# Groq — powers core chat, meme roast, and web search classification.
# Get a free key at: https://console.groq.com
GROQ_API_KEY=

# [OPTIONAL] Separate Groq key for the meme engine.
# Defaults to GROQ_API_KEY if not set.
GROQ_MEME_API_KEY=

# [OPTIONAL] Pollinations — powers image generation and MiniMax chat.
# Get a key at: https://pollinations.ai
POLLINATIONS_API_KEY=

# [OPTIONAL] OpenRouter — enables access to 200+ additional models.
# Get a key at: https://openrouter.ai
OPENROUTER_API_KEY=

# [OPTIONAL] NVIDIA NIM — enables Nemotron / Cosmos vision models.
# Get a free key at: https://build.nvidia.com
NVIDIA_API_KEY=

# [OPTIONAL] HuggingFace — enables 150+ free serverless inference models.
# Get a token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# [OPTIONAL] LLM7 — OpenAI-compatible gateway with free-token chat models.
# ⭐ REQUIRED to use LLM7 models. A free LLM7 token (from https://dash.llm7.io)
# is mandatory — ENZO deliberately does NOT call the anonymous tier, because the
# gateway serves a rotating shared model for unauthenticated calls (you'd get a
# different model than the one you picked). Token also raises limit to 120 RPM.
# The marketplace auto-discovers LLM7 models from the live /v1/models catalog
# via their `usage_based_only === false` eligibility flag.
LLM7_API_KEY=

# [OPTIONAL] Google AI Studio (Gemini) — enables Gemini free Flash-tier models.
# ⭐ REQUIRED to use google/ models. Create a free key at https://aistudio.google.com/apikey
# (no anonymous tier — keyless requests 404). Free tier: Flash/Flash-Lite only
# (~5–15 RPM, 250K TPM, up to ~1,500 RPD per project; RPD resets midnight PT);
# Pro models require billing. Marketplace auto-discovers Google models at sync
# time only when a key exists.
GEMINI_API_KEY=

# [OPTIONAL] Puter — user-pays OpenAI-compatible gateway (GPT / Claude / Gemini /
# Grok / Qwen) with free monthly credits. ⭐ REQUIRED to use puter/ models.
# Create an auth token at https://puter.com/dashboard ("Create token").
# IMPORTANT: Puter bills the END USER's own account (free credits first) — ENZO
# never charges you, but chat is not anonymous. Catalog is keyless/discovered
# automatically; chat and health probes require the token.
PUTER_AUTH_TOKEN=

# [OPTIONAL] Cloudflare Workers AI — Llama/Qwen/DeepSeek/Gemma + vision LLMs on
# the free tier (10K neurons/day). ⭐ REQUIRED to use cloudflare/ models.
# Create a token at https://dash.cloudflare.com/profile/api-tokens (permissions:
# "Workers AI:Edit" + "Account Settings:Read"/"Account:Read" so the account id
# can be auto-discovered). Account id is also storable separately. No anonymous
# tier — catalog + chat both require the token. Marketplace auto-discovers
# Cloudflare models at sync time only when a token exists.
CLOUDFLARE_API_TOKEN=
# [OPTIONAL] Cloudflare account id (path segment on every API call).
# Auto-discovered from the token when omitted; supply it to skip discovery.
CLOUDFLARE_ACCOUNT_ID=

# [OPTIONAL] Cloudflare OAuth App — enables the "Connect with Cloudflare" button
# in the signup/setup flow (real OAuth at dash.cloudflare.com/oauth2, PKCE).
# Create an OAuth app at https://dash.cloudflare.com/profile/api-tokens → "Create
# OAuth application"; set its redirect URI to your /api/auth/cloudflare/callback.
# The server exchanges the code server-side (client secret never leaves it),
# auto-discovers the account id, and writes the granted token into .env.
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=

# [OPTIONAL] LLM7 base URL override (default: https://api.llm7.io/v1)
# LLM7_API_BASE_URL=https://api.llm7.io/v1

# [OPTIONAL] Exa — the best of the four web-search backends (neural search with
# ranked snippets). Get a key at https://exa.ai
# Search NEVER hard-fails without it: search.ts falls through to DuckDuckGo HTML,
# then Bing RSS, then a Groq model with its own browsing. This key only buys
# better results. Callers may also send their own via the x-exa-key header.
EXA_API_KEY=

# ── HuggingFace OAuth App ─────────────────────────────────────────────────────
# [OPTIONAL] Enables the one-click "Connect HuggingFace" button in onboarding.
# Without it that button opens huggingface.co/settings/tokens instead and the
# user pastes a token — which works fine, so this is purely a convenience.
# Create an OAuth app at: https://huggingface.co/settings/applications
#
# TWO FILES, because the client id has to reach the browser and the secret must
# not: put the secret here, and the id in synthetic-nature/.env as
#   VITE_HF_CLIENT_ID=<your client id>
# Vite only exposes VITE_-prefixed variables to the bundle. Setting one without
# the other does nothing: no id means no button, no secret means the exchange
# returns 500 and the user lands back on the paste step.
# HuggingFace shows this as an `oauth_app_secret_…` string. Left empty here on
# purpose: CI greps every tracked file for that exact prefix followed by
# alphanumerics, so a realistic-looking placeholder fails the build.
HF_CLIENT_SECRET=

# ── Sign-in & deployment origin ───────────────────────────────────────────────

# ⭐ REQUIRED for Google sign-in. Signing secret for the session JWT.
# FAILS CLOSED: with this unset, /api/auth/google, its callback and /api/auth/me
# all return 503 with a setup message. There is deliberately NO fallback secret —
# a hardcoded one would let anyone forge a valid token for any account.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The rest of the app works fine without it; only Google sign-in is affected.
JWT_SECRET=

# Where the browser lives. EVERY OAuth flow redirects back here when it finishes,
# so a deployment that leaves this at the default lands its users on localhost and
# sign-in silently dead-ends. Set it to your real origin (no trailing slash).
# Default: http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# [OPTIONAL] Google OAuth app — powers "Sign in with Google" AND the Gmail /
# Calendar agent tools. Create credentials at https://console.cloud.google.com
# (APIs & Services → Credentials → OAuth client ID → Web application) and register
# BOTH redirect URIs below in that client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [OPTIONAL] Redirect URIs. The defaults are correct for local development; both
# must match what the Google client has registered, exactly, or the consent screen
# returns redirect_uri_mismatch.
# GOOGLE_REDIRECT_URI is for sign-in; GMAIL_REDIRECT_URI is for the Gmail/Calendar
# grant, which requests different scopes — they are separate on purpose.
# GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback
# GMAIL_REDIRECT_URI=http://localhost:5001/api/gmail/callback

# [OPTIONAL] Cloudflare OAuth callback (default:
# http://localhost:5001/api/auth/cloudflare/callback). Must match the redirect URI
# registered on the OAuth app above.
# CLOUDFLARE_OAUTH_REDIRECT_URI=http://localhost:5001/api/auth/cloudflare/callback

# [OPTIONAL] Cloudflare refresh token, written here automatically after an OAuth
# grant so the Workers AI token can be renewed without re-consenting.
CLOUDFLARE_REFRESH_TOKEN=

# ── Server ─────────────────────────────────────────────────────────────────────
# [OPTIONAL] Express backend port (default: 5001)
PORT=5001

# [OPTIONAL] ENZO tunnel master key — for OpenAI-compatible API endpoint auth.
# Change this to a strong random string in any non-local deployment.
# ⚠️  In HOSTED / BYOK mode leave this EMPTY: with no master key, the
# server-side vault writer (/api/vault/keys), memory and skills endpoints, and
# the /api/v1/chat/completions tunnel all fail closed (rejected) automatically —
# which is exactly what you want when every user owns their own keys.
# When unset, master-key-protected endpoints fail closed (all requests rejected).
ENZO_MASTER_KEY=

# [OPTIONAL] Comma-separated list of allowed CORS origins for browser clients.
# Requests without an Origin header (curl, server-to-server) are always allowed.
# Default: http://localhost:5173,http://localhost:5001
ENZO_CORS_ORIGINS=http://localhost:5173,http://localhost:5001

# [OPTIONAL] Auto-retry after a provider rate-limit (mid-build resume).
# Set ENZO_CHAT_AUTO_RETRY=0 to disable. ENZO_CHAT_AUTO_RETRY_MAX_MS caps the
# total background wait across all pauses (default 600000 = 10 min).
# ENZO_CHAT_AUTO_RETRY=1
# ENZO_CHAT_AUTO_RETRY_MAX_MS=600000

# [OPTIONAL] Thunder-pause: long builds pause between continuation rounds when
# the rolling 60s request window hits the provider's SOFT per-minute ceiling so
# the provider's *effective* lower limit (e.g. NVIDIA ~20 RPM despite the
# advertised 40) never cuts the build off mid-fence. Per-provider ceilings via
# ENZO_STREAM_RPM_<PROVIDER> (defaults: nvidia 15, openrouter 20, groq 30,
# pollinations 15, hf 20, llm7 15, google 10, puter 10, cloudflare 20).
# ENZO_STREAM_PAUSE_MS is the pause length (default 120000 = 2 min);
# ENZO_STREAM_PACING=0 disables the mechanism entirely.
# ENZO_STREAM_RPM_NVIDIA=15
# ENZO_STREAM_PAUSE_MS=120000
# ENZO_STREAM_PACING=1

# [OPTIONAL] Continue/extend context budget (coding mode). When a coding "continue"
# carries the active project id, the backend injects the ACTUAL on-disk project
# files into the model context so the model extends the real current code instead
# of restarting. This caps the total injected file characters (default 150000).
# ENZO_PROJECT_CONTEXT_CHARS=150000

# [OPTIONAL] Unsplash access key — reserved for a later feature (homepage imagery).
# Get one at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# ── Health monitor & generated-project runtime (tuning) ───────────────────────
# The background health monitor probes catalog models and records live status +
# measured latency (health.ts). It respects a per-provider daily probe budget, so
# raising the interval will not burn a free tier's quota — but lowering it means
# each pass has less time to finish.
# ENZO_HEALTH_PING_INTERVAL_MS=300000   # min gap between pass starts (5 min)
# ENZO_HEALTH_STARTUP_DELAY_MS=10000    # wait after boot before the first pass
# ENZO_HEALTH_CONCURRENCY=6             # parallel probes; raise carefully

# Coding-mode generated projects are spawned as real child processes with an
# explicit env allowlist (project-runtime.ts — see SECURITY.md).
# ENZO_PROJECT_RUNTIME_BOOT_MS=7000     # how long to wait for "listening"
# ENZO_PROJECT_RUNTIME_IDLE_MS=600000   # kill an idle project after 10 min

# [OPTIONAL] Set to `false` to disable the Unsplash wallpaper route entirely,
# independent of whether a key is present. Default: true
# UNSPLASH_ENABLED=true

# [OPTIONAL] NVIDIA NIM base URL override. Only https:// URLs on the NVIDIA
# allowlist in index.ts are accepted; anything else is rejected rather than
# silently used. Default: https://integrate.api.nvidia.com/v1
# NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
